{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "redim",
  "version": "0.0.0",
  "identifier": "com.mintya.redim",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "redim",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "tauri": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://gist.githubusercontent.com/mintya/2349bdae1e9d79747cd32f03db142e7b/raw/updater.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NkZDODcyMEM1RkJFNDEKUldSQnZsOE1jc2h2S1lWUUs3YWl2VE40cjY4dndnWGxOMlhURWlKeGsxNHNsM1BodHV3UzM1MjcK"
    }
  }
}
